SECRET_KEY=dev-secret-change-me
# 本地联调若连接共享测试库，请设为 false，由测试服务器统一执行后台任务。
TASK_RUNTIME_ENABLED=true
# 三个独立队列的全站并发上限；未配置时沿用 TASK_RUNTIME_MAX_CONCURRENCY（每队列默认 4）。
TASK_QUEUE_TEXT_CONCURRENCY=4
TASK_QUEUE_IMAGE_CONCURRENCY=4
TASK_QUEUE_VIDEO_CONCURRENCY=4
# 团队跨队列共用的生成槽位上限，同时受全站和个人上限限制。
TASK_TEAM_MAX_CONCURRENCY=4
# DEBUG=true 时应用日志更详细；SQL_ECHO=true 才打印原始 SQL（默认关，避免刷屏）
# DEBUG=true
# SQL_ECHO=false
# 仅支持 PostgreSQL（Docker 见 deploy/docker-compose.yml）
DATABASE_URL=postgresql+asyncpg://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
DATABASE_URL_SYNC=postgresql+psycopg2://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
# 默认 true：启动时建表、补列、初始化模板/管理员/导演技能，服务器保持开启。
# 本地 API 连接已初始化的共享测试库时可设 false：仅加载模型配置，不修改库结构或种子数据。
# 此开关独立于 TASK_RUNTIME_ENABLED；本地共享库联调通常同时关闭任务运行器。
DATABASE_BOOTSTRAP_ENABLED=true
# Postgres 生产建议：API uvicorn --workers 1，任务调度与 API 共用进程内连接池
# 单进程最多 70 条；PG max_connections=100 时给调试、迁移等保留 30 条。
# 多进程/多实例各自建池，须把所有进程的上限相加后核对数据库总预算。
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
REDIS_URL=redis://127.0.0.1:16379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 启动时将已有账号提升为 admin（逗号分隔邮箱，不造号）
# ADMIN_BOOTSTRAP_EMAILS=admin@example.com

ARK_MOCK=false
# Local media simulation only. Text LLM requests remain real; no provider media calls.
# Requests: .tmp/local-ai-requests.jsonl. Prepare fixtures with scripts/prepare_mock_media.py.
LOCAL_MEDIA_MOCK=false
# 开源版统一走 TokenFree New API（https://www.tokenfree.com/v1）。
# 请在管理后台「系统设置 → 模型」填写 API Key，拉取并选择模型；此处仅作首次导入。
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://www.tokenfree.com/v1
MODEL_LLM=

QUOTA_ENABLED=false

# Token 计费（用户价 = TokenFree 官方成本，不再加价）
BILLING_ENABLED=false
BILLING_MARKUP=1.0
# TokenFree / New API：500000 quota = 1 USD，按此汇率折人民币分
BILLING_USD_CNY=7.3
BILLING_SIGNUP_GRANT_FEN=500
# 易支付 pay.gitcc.com（密钥勿提交）
EPAY_API_URL=https://pay.gitcc.com
EPAY_PID=
EPAY_KEY=
# 生产 notify 勿含 /api/（易支付 WAF 会拦截）；线上 nginx 反代 /epay/notify → /api/billing/epay/notify
# EPAY_NOTIFY_URL=https://your-site.example.com/epay/notify
# EPAY_RETURN_URL=https://your-site.example.com/pricing?paid=1
# 真实 OSS / EPAY / 生产域名见本机 backend/.env.secrets.local（勿提交）

# Stripe Checkout：可在管理端「系统设置 → 支付计费 → Stripe 支付接入」配置，保存后生效
# 以下为可选部署初始值；数据库已保存配置（含明确清空）优先
# 密钥仅由后端读取；开启并配置两个密钥和有效返回地址后才显示 Stripe 支付方式
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 支付完成/取消后返回的前端地址；留空使用 PUBLIC_BASE_URL
# 本地前后端分开运行时可设为 http://localhost:5173
STRIPE_FRONTEND_URL=
# 按网站语言收款：中文 CNY、英文 USD；钱包仍按人民币到账。
STRIPE_CURRENCY=auto
# 1 美元对应多少人民币；英文收款需填写，不自动抓取市场报价。
STRIPE_USD_CNY_RATE=
# Stripe Dashboard 的 Snapshot webhook URL：
# https://your-site.example.com/api/billing/stripe/webhook

# 旗舰模型（需在方舟控制台开通；若账号仅支持接入点，可改为 ep-xxxxxxxx）
# 文字模型见上方 OPENAI_* / MODEL_LLM；以下为 Seedream/Seedance/TTS
MODEL_IMAGE=doubao-seedream-5-0-260128
# Seedream 4.5 接入点（可选；未配则回退 MODEL_IMAGE）
# MODEL_IMAGE_45=ep-xxxxxxxx
MODEL_VIDEO=doubao-seedance-2-5-260628
# Seedance 2.0 接入点（可选；与 2.5 并存时前台可选 seedance-2）
# MODEL_VIDEO_2=doubao-seedance-2-0-260128
SEEDANCE_DURATION_MIN=4
SEEDANCE_DURATION_MAX=30
# 科普 Seedance 仍出音轨：只要键盘/点击等操作环境音，不要口播与 BGM
# 科普 full 默认用 Seedance 视频内置口播；关则回退到外部 TTS
KEPU_SEEDANCE_NATIVE_AUDIO=true
# 仅当 NATIVE_AUDIO=false 时：Seedance 只要操作音效 + 后期 TTS（建议保持 true）
KEPU_SEEDANCE_SFX_AUDIO=true
# 音频/TTS 上游模型 ID（TokenFree 目录现用 qwen-tts；seed-tts-2.0 已下线）
MODEL_AUDIO=qwen-tts-2025-05-22

# 上游用量对照改走 TokenFree New API（与「模型」页同一把 Key），无需火山管控面 AK/SK
# BILLING_USD_CNY=7.3

ARK_IMAGE_SIZE=2k
ARK_VIDEO_RESOLUTION=480p
ARK_VIDEO_RATIO=16:9
ARK_VIDEO_POLL_INTERVAL=8
ARK_VIDEO_POLL_TIMEOUT=900
PIPELINE_IMAGE_CONCURRENCY=3
TOKENFREE_IMAGE_CONCURRENCY=1
PIPELINE_VIDEO_CONCURRENCY=10
PIPELINE_AUDIO_CONCURRENCY=4

# Aliyun OSS（成片/分镜上传；FFmpeg 仍用本地文件。前端 dist 见 deploy/scripts/upload_oss_web.py）
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket
OSS_FOLDER=kepu
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
# OSS_PUBLIC_BASE=https://cdn.example.com
