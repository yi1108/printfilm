# 下游默认关闭。仅作配置说明，不包含真实凭证，也不改变上游 OSS_*。
# 线上没有这份文件时，在管理端「系统设置 → 站点工具」打开。保存后以数据库为准。
MARKETPLACE_ENABLED=false
MARKETPLACE_APP_ENABLED=false
MARKETPLACE_SOCIAL_ENABLED=true
MARKETPLACE_COMMENTS_ENABLED=true
# OSS 共用后台「系统设置 → 存储 OSS」配置，无需 MARKETPLACE_OSS_*。
# 数字资产市场固定使用 marketplace/；原业务 OSS_FOLDER 保持原意。
MARKETPLACE_SIGNED_URL_SECONDS=300
MARKETPLACE_MAX_VIDEO_BYTES=524288000
MARKETPLACE_MAX_DOCUMENT_BYTES=20971520
MARKETPLACE_MAX_DURATION_SECONDS=1800
MARKETPLACE_PART_SIZE=8388608
# Windows 本机默认字体；Linux 部署须设置实际安装的中文字体绝对路径。
MARKETPLACE_WATERMARK_FONT=C:/Windows/Fonts/msyh.ttc
MARKETPLACE_WORKER_POLL_SECONDS=3
MARKETPLACE_WORKER_MAX_ATTEMPTS=3
